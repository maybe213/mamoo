@model DrugInventoryPro.Models.Departments

@{
    ViewData["Title"] = "เพิ่มแผนก";
}

<style>
    /* ตัวแปรสีตามมาตรฐาน Medical UI/UX */
    :root {
        --app-bg: #F4F5F7;
        --card-bg: #FFFFFF;
        --text-main: #333333;
        --text-muted: #5A6268;
        --border-color: #E2E8F0;
        --color-primary: #026AA7;
        --color-primary-hover: #025383;
        --color-input-focus: rgba(2, 106, 167, 0.15);
    }

    body {
        background-color: var(--app-bg);
        font-family: 'Sarabun', sans-serif;
        color: var(--text-main);
    }

    .container-custom {
        max-width: 650px;
        margin-top: 50px;
        margin-bottom: 50px;
    }

    .card-department {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .card-header-clean {
        background-color: #F8F9FA;
        border-bottom: 1px solid var(--border-color);
        padding: 20px 24px;
        border-top: 4px solid var(--color-primary); /* เส้นสีน้ำเงินบอกว่าเป็นหน้าจัดการข้อมูลหลัก */
    }

    .header-title {
        color: var(--color-primary);
        font-weight: 700;
        margin: 0;
        font-size: 1.25rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-label {
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 6px;
        font-size: 0.95rem;
    }

    .form-control, .form-select {
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 10px 14px;
        color: var(--text-main);
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px var(--color-input-focus);
            outline: none;
        }

    .form-control-readonly {
        background-color: #F1F5F9 !important;
        color: var(--text-muted);
        cursor: not-allowed;
        font-weight: 600;
        font-family: monospace;
        font-size: 1.1rem;
    }

    /* ปรับแต่ง Input Group Text ให้ดูคลีนสบายตา */
    .input-group-text {
        background-color: #F8F9FA;
        border-color: #ced4da;
        color: var(--color-primary);
        width: 48px;
        justify-content: center;
        font-size: 1.1rem;
    }

    /* ปุ่ม Action ตามหลักจิตวิทยาสี */
    .btn-action {
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-cancel {
        background-color: #E2E8F0;
        color: var(--text-main);
    }

        .btn-cancel:hover {
            background-color: #CBD5E1;
            color: var(--text-main);
        }

    .btn-primary-action {
        background-color: var(--color-primary);
        color: #FFFFFF;
    }

        .btn-primary-action:hover {
            background-color: var(--color-primary-hover);
            color: #FFFFFF;
            box-shadow: 0 4px 8px rgba(2, 106, 167, 0.2);
        }
</style>

<div class="container container-custom">
    <div class="card card-department">
        <div class="card-header-clean">
            <h4 class="header-title"><i class="bi bi-building-add fs-4"></i> เพิ่มข้อมูลแผนกใหม่</h4>
        </div>
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post">

                <!-- รหัสแผนก (ระบบสร้างอัตโนมัติ) -->
                <div class="mb-4">
                    <label class="form-label">รหัสแผนก <span class="text-muted fw-normal small">(ระบบสร้างให้อัตโนมัติ)</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                        <input asp-for="Department_id" class="form-control form-control-readonly" value="@ViewBag.AutoId" readonly />
                    </div>
                </div>

                <!-- ชื่อแผนก -->
                <div class="mb-4">
                    <label class="form-label">ชื่อแผนก <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-hospital"></i></span>
                        <input asp-for="Department_name" class="form-control" placeholder="เช่น แผนกอายุรกรรม" required />
                    </div>
                    <span asp-validation-for="Department_name" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- ผู้ติดต่อประสานงาน -->
                <div class="mb-4 p-3 rounded" style="background-color: #F8F9FA; border: 1px solid var(--border-color);">
                    <label class="form-label mb-3 text-primary"><i class="bi bi-person-badge me-2"></i>ผู้ติดต่อประสานงาน (ภาษาไทยเท่านั้น) <span class="text-danger">*</span></label>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <select asp-for="Contact_title" class="form-select" required>
                                <option value="" selected disabled>คำนำหน้า...</option>
                                <option value="นาย">นาย</option>
                                <option value="นาง">นาง</option>
                                <option value="นางสาว">นางสาว</option>
                                <option value="ภก.">ภก.</option>
                                <option value="ภญ.">ภญ.</option>
                                <option value="นพ.">นพ.</option>
                                <option value="พญ.">พญ.</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input asp-for="Contact_firstname" class="form-control" placeholder="ชื่อ" required pattern="^[ก-๙]+$" title="กรุณากรอกชื่อเป็นภาษาไทยเท่านั้น" />
                        </div>
                        <div class="col-md-5">
                            <input asp-for="Contact_lastname" class="form-control" placeholder="นามสกุล" required pattern="^[ก-๙]+$" title="กรุณากรอกนามสกุลเป็นภาษาไทยเท่านั้น" />
                        </div>
                    </div>
                    <span asp-validation-for="Contact_firstname" class="text-danger small mt-2 d-block"></span>
                    <span asp-validation-for="Contact_lastname" class="text-danger small d-block"></span>
                </div>

                <!-- เบอร์โทรศัพท์ -->
                <div class="mb-4">
                    <label class="form-label">เบอร์โทรศัพท์ติดต่อ</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-telephone-fill"></i></span>
                        <input asp-for="Phone_number" class="form-control" placeholder="เช่น 02-XXX-XXXX" />
                    </div>
                </div>

                <!-- สถานะการใช้งาน -->
                <div class="mb-5">
                    <label class="form-label">สถานะการใช้งาน</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-toggle-on"></i></span>
                        <select asp-for="Status" class="form-select fw-bold">
                            <option value="Active">เปิดใช้งาน (Active)</option>
                            <option value="Inactive">ปิดใช้งาน (Inactive)</option>
                        </select>
                    </div>
                </div>

                <!-- ปุ่มควบคุม -->
                <div class="d-flex justify-content-between pt-3 border-top">
                    <a asp-action="Index" class="btn-action btn-cancel">
                        <i class="bi bi-arrow-left"></i> ยกเลิก
                    </a>
                    <button type="submit" class="btn-action btn-primary-action shadow-sm">
                        <i class="bi bi-floppy-fill"></i> บันทึกข้อมูล
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
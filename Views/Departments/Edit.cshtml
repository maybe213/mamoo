@model DrugInventoryPro.Models.Departments

@{
    ViewData["Title"] = "แก้ไขแผนก";
}

<style>
    /* 🌟 กฎข้อ 1: ใช้โทนสี Clean & Muted เพื่อลดความล้าของสายตา */
    :root {
        --app-bg: #F4F5F7; /* พื้นหลังเทาอ่อน ลด Glare */
        --card-bg: #FFFFFF;
        --text-main: #333333; /* ตัวอักษรเทาเข้ม แทนสีดำสนิท */
        --text-muted: #5A6268;
        --border-color: #E2E8F0;
        --color-primary: #026AA7; /* สีน้ำเงิน สำหรับปุ่มและข้อมูลหลัก */
        --color-primary-hover: #025383;
        --color-input-focus: rgba(2, 106, 167, 0.15);
    }

    body {
        background-color: var(--app-bg);
        font-family: 'Sarabun', sans-serif;
        color: var(--text-main);
    }

    .container-edit {
        max-width: 650px;
        margin-top: 50px;
        margin-bottom: 50px;
    }

    .card-edit {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    /* เปลี่ยนจากหัวสีดำ/ชมพู เป็นโทนสะอาดตา */
    .card-header-clean {
        background-color: #F8F9FA;
        border-bottom: 1px solid var(--border-color);
        padding: 20px 24px;
        border-top: 4px solid var(--color-primary); /* เส้นสีน้ำเงินระบุว่าเป็น Action หลัก */
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-title {
        color: var(--color-primary);
        font-weight: 700;
        margin: 0;
        font-size: 1.25rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-label {
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 6px;
        font-size: 0.95rem;
    }

    .form-control, .form-select {
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 10px 14px;
        color: var(--text-main);
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px var(--color-input-focus);
            outline: none;
        }

    /* ปรับปรุง Input Group Text ให้ดูเป็นเนื้อเดียวกับฟอร์ม */
    .input-group-text {
        background-color: #F8F9FA;
        border-color: #ced4da;
        color: var(--color-primary);
        width: 48px;
        justify-content: center;
        font-size: 1.1rem;
    }

    /* 🌟 กฎข้อ 2: สีปุ่ม Action ใช้สีสากล */
    .btn-action {
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-cancel {
        background-color: #E2E8F0;
        color: var(--text-main);
    }

        .btn-cancel:hover {
            background-color: #CBD5E1;
            color: var(--text-main);
        }

    .btn-save {
        background-color: var(--color-primary);
        color: #FFFFFF;
    }

        .btn-save:hover {
            background-color: var(--color-primary-hover);
            color: #FFFFFF;
            box-shadow: 0 4px 8px rgba(2, 106, 167, 0.2);
        }

    /* ป้ายบอก ID แผนก */
    .info-tag {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 600;
        background-color: #F1F5F9;
        padding: 6px 12px;
        border-radius: 6px;
        display: inline-block;
        border: 1px solid var(--border-color);
        font-family: monospace;
    }
</style>

<div class="container container-edit">
    <div class="card card-edit shadow-sm">
        <div class="card-header-clean">
            <h4 class="header-title"><i class="bi bi-pencil-square fs-4"></i> แก้ไขข้อมูลแผนก</h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <!-- แสดง ID แผนกให้ดูเรียบร้อย สบายตา -->
            <div class="mb-4 text-end">
                <span class="info-tag"><i class="bi bi-upc-scan me-1"></i> ID แผนก: @Model?.Department_id</span>
            </div>

            <form asp-action="Edit" method="post">
                @* เก็บ ID, วันที่สร้างไว้เป็น Hidden เพื่อไม่ให้ค่าสูญหาย *@
                <input type="hidden" asp-for="Department_id" />
                <input type="hidden" asp-for="Created_at" />

                <!-- 1. ชื่อแผนก -->
                <div class="mb-4">
                    <label class="form-label">ชื่อแผนก <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-hospital"></i></span>
                        <input asp-for="Department_name" class="form-control" placeholder="ระบุชื่อแผนก" required />
                    </div>
                    <span asp-validation-for="Department_name" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- 2. ผู้ติดต่อประสานงาน (จัดกลุ่มข้อมูลด้วยพื้นหลังสีอ่อนตามหลัก Gestalt) -->
                <div class="mb-4 p-3 rounded" style="background-color: #F8F9FA; border: 1px solid var(--border-color);">
                    <label class="form-label mb-3 text-primary"><i class="bi bi-person-badge me-2"></i>ผู้ติดต่อประสานงาน (ภาษาไทยเท่านั้น) <span class="text-danger">*</span></label>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <select asp-for="Contact_title" class="form-select" required>
                                <option value="" disabled>คำนำหน้า...</option>
                                <option value="นาย">นาย</option>
                                <option value="นาง">นาง</option>
                                <option value="นางสาว">นางสาว</option>
                                <option value="ภก.">ภก.</option>
                                <option value="ภญ.">ภญ.</option>
                                <option value="นพ.">นพ.</option>
                                <option value="พญ.">พญ.</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input asp-for="Contact_firstname" class="form-control" placeholder="ชื่อ"
                                   required pattern="^[ก-๙]+$" title="กรุณากรอกชื่อเป็นภาษาไทยเท่านั้น" />
                        </div>
                        <div class="col-md-5">
                            <input asp-for="Contact_lastname" class="form-control" placeholder="นามสกุล"
                                   required pattern="^[ก-๙]+$" title="กรุณากรอกนามสกุลเป็นภาษาไทยเท่านั้น" />
                        </div>
                    </div>
                    <span asp-validation-for="Contact_firstname" class="text-danger small mt-2 d-block"></span>
                    <span asp-validation-for="Contact_lastname" class="text-danger small d-block"></span>
                </div>

                <!-- 3. เบอร์โทรศัพท์ -->
                <div class="mb-4">
                    <label class="form-label">เบอร์โทรศัพท์ติดต่อ</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-telephone-fill"></i></span>
                        <input asp-for="Phone_number" class="form-control" placeholder="เช่น 02-XXX-XXXX" />
                    </div>
                    <span asp-validation-for="Phone_number" class="text-danger small"></span>
                </div>

                <!-- 4. สถานะ -->
                <div class="mb-5">
                    <label class="form-label">สถานะการใช้งาน</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-toggle-on"></i></span>
                        <select asp-for="Status" class="form-select fw-bold">
                            <option value="Active">เปิดใช้งาน (Active)</option>
                            <option value="Inactive">ปิดใช้งาน (Inactive)</option>
                        </select>
                    </div>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <!-- ปุ่มควบคุม -->
                <div class="d-flex justify-content-between align-items-center border-top pt-4">
                    <a asp-action="Index" class="btn-action btn-cancel">
                        <i class="bi bi-arrow-left"></i> ยกเลิก
                    </a>
                    <button type="submit" class="btn-action btn-save shadow-sm">
                        <i class="bi bi-floppy-fill"></i> บันทึกการแก้ไข
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
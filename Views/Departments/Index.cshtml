@model List<DrugInventoryPro.Models.Departments>

@{
    ViewData["Title"] = "จัดการข้อมูลแผนก";
}

<style>
    /* ตัวแปรชุดสีตามหลัก Medical UI/UX เพื่อลดความล้าของสายตา */
    :root {
        --app-bg: #F4F5F7;
        --card-bg: #FFFFFF;
        --text-main: #333333;
        --text-muted: #5A6268;
        --border-color: #E2E8F0;
        --color-primary: #026AA7;
        --color-primary-hover: #025383;
    }

    body {
        background-color: var(--app-bg);
        font-family: 'Sarabun', sans-serif;
        color: var(--text-main);
    }

    .page-header {
        border-left: 5px solid var(--color-primary);
        padding-left: 15px;
        margin-bottom: 25px;
    }

    .btn-create-primary {
        background-color: var(--color-primary);
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 50px;
        font-weight: 600;
        transition: 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .btn-create-primary:hover {
            background-color: var(--color-primary-hover);
            color: white;
            box-shadow: 0 4px 8px rgba(2, 106, 167, 0.2);
        }

    .table-container {
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        background: var(--card-bg);
    }

    /* ตารางแบบ Clean Design */
    .table-custom thead {
        background-color: #F8F9FA;
        color: var(--color-primary);
        border-top: 4px solid var(--color-primary);
    }

    .table-custom th {
        border: none !important;
        padding: 16px 15px !important;
        font-size: 0.95rem;
        font-weight: 700;
        border-bottom: 1px solid var(--border-color) !important;
    }

    .table-custom td {
        padding: 14px 15px !important;
        vertical-align: middle;
        border-bottom: 1px solid #F1F5F9;
        color: var(--text-main);
    }

    .table-custom tbody tr:hover {
        background-color: #F8FAFC !important;
    }

    /* Status Badges แบบ Soft Tones */
    .badge-status {
        padding: 6px 12px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .status-active {
        background-color: #ECFDF5;
        color: #059669;
        border: 1px solid #A7F3D0;
    }

    .status-inactive {
        background-color: #FEF2F2;
        color: #DC2626;
        border: 1px solid #FECACA;
    }

    /* Action Buttons (แก้ไข / ลบ) */
    .btn-action {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: 0.2s;
        border: none;
        text-decoration: none;
    }

    .btn-edit-action {
        background: #F0F9FF;
        color: var(--color-primary);
    }

        .btn-edit-action:hover {
            background: var(--color-primary);
            color: white;
        }

    .btn-delete-action {
        background: #FEF2F2;
        color: #DC2626;
    }

        .btn-delete-action:hover {
            background: #DC2626;
            color: white;
        }
</style>

<div class="container-fluid p-4">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert" style="border-radius: 12px; border-left: 5px solid #dc3545; background-color: #FEF2F2; color: #DC2626; border-color: #FECACA;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center page-header">
        <h3 class="m-0 fw-bold" style="color: var(--color-primary);">รายชื่อแผนกในระบบ</h3>
        <a asp-action="Create" class="btn-create-primary shadow-sm">
            <i class="bi bi-building-add me-2"></i> เพิ่มแผนกใหม่
        </a>
    </div>

    <div class="table-container shadow-sm">
        <div class="table-responsive">
            <table class="table table-custom text-center mb-0">
                <thead>
                    <tr>
                        <th>รหัสแผนก</th>
                        <th class="text-start">ชื่อแผนก</th>
                        <th>ผู้ประสานงาน</th>
                        <th>เบอร์โทรศัพท์</th>
                        <th>สถานะ</th>
                        <th>วันที่สร้างข้อมูล</th>
                        <th>แก้ไขล่าสุด</th>
                        <th>จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@item.Department_id</td>
                                <td class="text-start fw-bold" style="color: var(--color-primary);">@item.Department_name</td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.Contact_firstname))
                                    {
                                        @($"{item.Contact_title}{item.Contact_firstname} {item.Contact_lastname}")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>@(string.IsNullOrEmpty(item.Phone_number) ? "-" : item.Phone_number)</td>

                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge-status status-active"><i class="bi bi-check-circle-fill"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status status-inactive"><i class="bi bi-x-circle-fill"></i> Inactive</span>
                                    }
                                </td>

                                <td class="text-muted" style="font-size: 0.85rem;">
                                    @(item.Created_at.HasValue? item.Created_at.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                </td>
                                <td class="text-muted" style="font-size: 0.85rem;">
                                    @(item.Updated_at.HasValue? item.Updated_at.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                </td>

                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Department_id"
                                           class="btn-action btn-edit-action" title="แก้ไข">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Department_id"
                                           class="btn-action btn-delete-action"
                                           onclick="return confirm('คุณต้องการลบแผนก @item.Department_name ใช่หรือไม่?')" title="ลบ">
                                            <i class="bi bi-trash3-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                ยังไม่มีข้อมูลแผนกในระบบ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
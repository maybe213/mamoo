@model DrugInventoryPro.Models.Medicines

@{
    ViewData["Title"] = "ยืนยันการลบยา";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool hasHistory = ViewBag.HasDispenseHistory ?? false;
    int currentStock = Model?.Stock ?? 0;
    bool isSoftDeleteMode = (currentStock > 0 || hasHistory);
}

<style>
    :root {
        --primary-color: #2563EB;
        --bg-main: #F8FAFC;
        --card-bg: #FFFFFF;
        --text-dark: #0F172A;
        --text-muted: #64748B;
        --border-color: #E2E8F0;
        --alert-warning-bg: #FFFBEB;
        --alert-warning-border: #F59E0B;
        --alert-warning-text: #92400E;
        --alert-critical-bg: #FEF2F2;
        --alert-critical-border: #EF4444;
        --alert-critical-text: #991B1B;
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-dark);
        font-family: 'Sarabun', sans-serif;
    }

    .delete-container {
        max-width: 650px;
        margin: 60px auto;
    }

    .card-clean {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .alert-box {
        padding: 20px;
        border-left: 5px solid;
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 20px;
    }

    .alert-warning {
        background-color: var(--alert-warning-bg);
        border-color: var(--alert-warning-border);
        color: var(--alert-warning-text);
    }

    .alert-critical {
        background-color: var(--alert-critical-bg);
        border-color: var(--alert-critical-border);
        color: var(--alert-critical-text);
    }

    .alert-icon {
        font-size: 1.6rem;
        line-height: 1;
    }

    .info-container {
        background-color: #F8FAFC;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 8px 20px;
    }

    .info-row {
        display: flex;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color);
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        width: 35%;
        color: var(--text-muted);
        font-weight: 500;
        font-size: 0.925rem;
    }

    .info-value {
        width: 65%;
        color: var(--text-dark);
        font-weight: 600;
        font-size: 0.975rem;
    }

    .btn-action {
        padding: 10px 22px;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-cancel {
        background-color: #FFFFFF;
        border: 1px solid var(--border-color);
        color: var(--text-dark);
        text-decoration: none;
    }

        .btn-cancel:hover {
            background-color: #F1F5F9;
            color: var(--text-dark);
        }

    .btn-warning-action {
        background-color: var(--alert-warning-border);
        color: #FFFFFF;
    }

        .btn-warning-action:hover {
            background-color: #D97706;
        }

    .btn-critical-action {
        background-color: var(--alert-critical-border);
        color: #FFFFFF;
    }

        .btn-critical-action:hover {
            background-color: #DC2626;
        }
</style>

<div class="delete-container">
    <div class="card-clean p-4">
        @if (isSoftDeleteMode)
        {
            <div class="alert-box alert-warning rounded-3">
                <div class="alert-icon">⚠️</div>
                <div>
                    <h5 class="fw-bold mb-1">คำเตือน: ต้องการปิดใช้งานเวชภัณฑ์?</h5>
                    <p class="mb-0 fs-6 opacity-90">เนื่องจากยามีสต็อกคงเหลือหรือเคยมีประวัติการจ่ายยา ระบบจะทำการระงับการใช้งานแทนการลบถาวร</p>
                </div>
            </div>
        }
        else
        {
            <div class="alert-box alert-critical rounded-3">
                <div class="alert-icon">❌</div>
                <div>
                    <h5 class="fw-bold mb-1">วิกฤต: ยืนยันการลบข้อมูลถาวร?</h5>
                    <p class="mb-0 fs-6 opacity-90">รายการนี้เป็นรายการเพิ่มผิด <strong>เมื่อลบแล้วจะไม่สามารถกู้คืนข้อมูลได้</strong></p>
                </div>
            </div>
        }

        <div class="info-container mt-4 mb-4">
            <div class="info-row">
                <div class="info-label">ชื่อยา / เวชภัณฑ์</div>
                <div class="info-value text-primary fs-6">
                    @Model?.Medicine_name
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">รหัสยา (Item ID)</div>
                <div class="info-value font-monospace"><code>@Model?.Medicine_id</code></div>
            </div>

            <div class="info-row">
                <div class="info-label">หมวดหมู่</div>
                <div class="info-value">@(Model?.Category?.Category_name ?? Model?.Category_id)</div>
            </div>

            <div class="info-row">
                <div class="info-label">หน่วย / ราคาทุน</div>
                <div class="info-value">@Model?.Unit_id | @(Model?.Price.ToString("N2") ?? "0.00") บาท</div>
            </div>

            <div class="info-row">
                <div class="info-label">คงเหลือในคลัง</div>
                <div class="info-value">
                    @(Model?.Stock?.ToString("N0") ?? "0") @Model?.Unit_id
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
            <a asp-action="Index" class="btn-action btn-cancel">
                <i class="bi bi-arrow-left"></i> กลับหน้ารายการ
            </a>

            <form asp-action="Delete" asp-route-id="@Model.Medicine_id" method="post"
                  onsubmit="return confirm('@(isSoftDeleteMode ? "ยืนยันการปิดใช้งานยารายการนี้ (รหัส: " + Model.Medicine_id + ") ใช่หรือไม่?" : "ยืนยันการลบรายการยานี้ออกจากฐานข้อมูลถาวรใช่หรือไม่?")');">
                @Html.AntiForgeryToken()

                @if (isSoftDeleteMode)
                {
                    <button type="submit" class="btn-action btn-warning-action shadow-sm">
                        <i class="bi bi-eye-slash-fill"></i> ยืนยันปิดใช้งาน
                    </button>
                }
                else
                {
                    <button type="submit" class="btn-action btn-critical-action shadow-sm">
                        <i class="bi bi-trash3-fill"></i> ยืนยันลบถาวร
                    </button>
                }
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
@model IEnumerable<DrugInventoryPro.Models.Medicines>

@{
    ViewData["Title"] = "คลังยาและเวชภัณฑ์";

    // 🔹 รับค่าค้นหาและค่าการเรียงลำดับจาก Query String
    string currentSearch = Context.Request.Query["search"].ToString();
    string currentSort = ViewBag.CurrentSort as string ?? "id_asc";

    // 🟢 กรองประเภท ยา / เวชภัณฑ์
    var rawSupplies = Model?.Where(m => m.Category?.Category_name != null
                                  && m.Category.Category_name.Contains("เวชภัณฑ์")).ToList()
                    ?? new List<DrugInventoryPro.Models.Medicines>();

    var rawMedicines = Model?.Where(m => !rawSupplies.Contains(m)).ToList()
                     ?? new List<DrugInventoryPro.Models.Medicines>();

    // 🎯 ฟังก์ชันสำหรับเรียงลำดับข้อมูล
    IEnumerable<DrugInventoryPro.Models.Medicines> ApplySorting(IEnumerable<DrugInventoryPro.Models.Medicines> list, string sortBy)
    {
        return sortBy switch
        {
            "id_asc" => list.OrderBy(m => m.Medicine_id),
            "id_desc" => list.OrderByDescending(m => m.Medicine_id),
            "stock_desc" => list.OrderByDescending(m => m.Stock ?? 0),
            "stock_asc" => list.OrderBy(m => m.Stock ?? 0),
            "low_stock" => list.OrderBy(m => m.Stock ?? 0),
            "expired_asc" => list.OrderBy(m => m.Expired_at.HasValue ? 0 : 1).ThenBy(m => m.Expired_at),
            "expired_desc" => list.OrderBy(m => m.Expired_at.HasValue ? 0 : 1).ThenByDescending(m => m.Expired_at),
            _ => list.OrderBy(m => m.Medicine_id) // ค่าเริ่มต้น: เรียงตามรหัส
        };
    }

    var supplies = ApplySorting(rawSupplies, currentSort).ToList();
    var medicines = ApplySorting(rawMedicines, currentSort).ToList();
}

<style>
    :root {
        --theme-primary: #0d6efd;
        --theme-primary-hover: #0b5ed7;
        --theme-dark: #212529;
        --theme-light-bg: #f8f9fa;
        --theme-hover-bg: #f1f8ff;
        --theme-border: #dee2e6;
    }

    .dash-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .dash-table thead th {
            background: var(--theme-dark);
            color: #ffffff;
            padding: 15px;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 1px;
            white-space: nowrap;
        }

        .dash-table tbody tr {
            transition: background-color 0.2s ease;
        }

            .dash-table tbody tr:hover {
                background: var(--theme-hover-bg);
            }

        .dash-table td {
            padding: 15px;
            border-bottom: 1px solid var(--theme-border);
            vertical-align: middle;
            white-space: nowrap;
        }

    .btn-theme-edit {
        background: var(--theme-dark);
        color: #ffffff;
        border: none;
        transition: all 0.2s ease;
    }

        .btn-theme-edit:hover {
            background: var(--theme-primary);
            color: #ffffff;
        }

    .btn-theme-del {
        border: 1px solid #dc3545;
        color: #dc3545;
        background: transparent;
        transition: all 0.2s ease;
    }

        .btn-theme-del:hover {
            background: #dc3545;
            color: #ffffff;
        }

    .table-container {
        background: #ffffff;
        padding: 25px;
        border-radius: 16px;
        border: 1px solid var(--theme-border);
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }
</style>

<div class="dashboard-wrapper mt-4">
    <div class="page-title mb-4 fw-bold fs-4 text-dark">
        <i class="bi bi-capsule text-primary"></i> คลังยาและเวชภัณฑ์
    </div>

    <!-- 🔹 Tab แยกประเภท ยา / เวชภัณฑ์ -->
    <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="pills-medicine-tab" data-bs-toggle="pill" data-bs-target="#pills-medicine" type="button" role="tab">
                💊 รายการยา (@medicines.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="pills-supply-tab" data-bs-toggle="pill" data-bs-target="#pills-supply" type="button" role="tab">
                🩹 รายการเวชภัณฑ์ (@supplies.Count)
            </button>
        </li>
    </ul>

    @* แจ้งเตือนข้อผิดพลาด *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* แจ้งเตือนทำรายการสำเร็จ *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h5 class="fw-bold mb-0 text-dark">รายการยาในคลังปัจจุบัน</h5>

            <div class="d-flex gap-2">
                <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center">
                    <i class="bi bi-gear me-1"></i> เพิ่มหมวดหมู่/ หน่วยนับ
                </a>
                <a asp-action="Create" class="btn btn-primary btn-sm d-flex align-items-center fw-bold">
                    <i class="bi bi-plus-lg me-1"></i> เพิ่มรายการใหม่
                </a>
            </div>
        </div>

        <!-- 🔹 ฟอร์มค้นหา และ ตัวเลือกการเรียงลำดับ -->
        <form method="get" asp-action="Index" class="mb-3">
            <div class="row g-2">
                <!-- ช่องค้นหา -->
                <div class="col-md-7 col-12">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="ค้นหาด้วยรหัส หรือชื่อเวชภัณฑ์ยา..." value="@currentSearch" />
                        <button type="submit" class="btn btn-dark"><i class="bi bi-search me-1"></i> ค้นหา</button>
                        @if (!string.IsNullOrEmpty(currentSearch))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary" title="ล้างการค้นหา"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                </div>

                <!-- ตัวเลือกการเรียงลำดับ (Sorting) -->
                <div class="col-md-5 col-12">
                    <div class="input-group">
                        <select name="sortBy" class="form-select" onchange="this.form.submit()">
                            <option value="id_asc" selected="@(currentSort == "id_asc" || string.IsNullOrEmpty(currentSort))">รหัส (น้อยไปมาก)</option>
                            <option value="id_desc" selected="@(currentSort == "id_desc")">รหัส (มากไปน้อย)</option>
                            <option value="stock_desc" selected="@(currentSort == "stock_desc")">จำนวนสต็อก (มากไปน้อย)</option>
                            <option value="stock_asc" selected="@(currentSort == "stock_asc")">จำนวนสต็อก (น้อยไปมาก)</option>
                            <option value="low_stock" selected="@(currentSort == "low_stock")">สต็อกต่ำกว่าเกณฑ์ก่อน</option>
                            <option value="expired_asc" selected="@(currentSort == "expired_asc")">วันหมดอายุ (หมดอายุก่อน - หลัง)</option>
                            <option value="expired_desc" selected="@(currentSort == "expired_desc")">วันหมดอายุ (หมดอายุหลัง - ก่อน)</option>
                        </select>
                    </div>
                </div>
            </div>
        </form>

        <!-- 🔹 Tab Content สลับหน้าตาราง -->
        <div class="tab-content" id="pills-tabContent">

            <!-- 1. ตารางรายการยา -->
            <div class="tab-pane fade show active" id="pills-medicine" role="tabpanel">
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>รหัสยา</th>
                                <th>ชื่อยา</th>
                                <th class="text-center">สต็อก</th>
                                <th>ล็อต</th>
                                <th>วันหมดอายุ</th>
                                <th>ราคาทุน</th>
                                <th class="text-center">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!medicines.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                        ไม่พบรายการยาในระบบคลัง
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in medicines)
                                {
                                    <tr>
                                        <td><small class="text-muted fw-bold">@item.Medicine_id</small></td>
                                        <td class="fw-bold text-dark">@item.Medicine_name</td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill px-3 py-2" style="background:@(item.Stock < 10 ? "#dc3545" : "#6c757d")">
                                                @item.Stock
                                            </span>
                                        </td>
                                        <td><code class="text-primary fw-bold">@item.Lot</code></td>
                                        <td>@(item.Expired_at.HasValue? item.Expired_at.Value.ToString("dd/MM/yyyy") : "-")</td>
                                        <td>@item.Price.ToString("N2") ฿</td>
                                        <td class="text-center">
                                            <div class="d-inline-flex gap-1">
                                                <a asp-action="Edit" asp-route-id="@item.Medicine_id" class="btn btn-sm btn-theme-edit" title="แก้ไข">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Medicine_id" class="btn btn-sm btn-theme-del" title="ลบข้อมูล">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. ตารางรายการเวชภัณฑ์ -->
            <div class="tab-pane fade" id="pills-supply" role="tabpanel">
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>รหัสเวชภัณฑ์</th>
                                <th>ชื่อเวชภัณฑ์</th>
                                <th class="text-center">สต็อก</th>
                                <th>ล็อต</th>
                                <th>วันหมดอายุ</th>
                                <th>ราคาทุน</th>
                                <th class="text-center">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!supplies.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                        ไม่พบรายการเวชภัณฑ์ในระบบคลัง
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in supplies)
                                {
                                    <tr>
                                        <td><small class="text-muted fw-bold">@item.Medicine_id</small></td>
                                        <td class="fw-bold text-dark">@item.Medicine_name</td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill px-3 py-2" style="background:@(item.Stock < 10 ? "#dc3545" : "#6c757d")">
                                                @item.Stock
                                            </span>
                                        </td>
                                        <td><code class="text-primary fw-bold">@item.Lot</code></td>
                                        <td>@(item.Expired_at.HasValue? item.Expired_at.Value.ToString("dd/MM/yyyy") : "-")</td>
                                        <td>@item.Price.ToString("N2") ฿</td>
                                        <td class="text-center">
                                            <div class="d-inline-flex gap-1">
                                                <a asp-action="Edit" asp-route-id="@item.Medicine_id" class="btn btn-sm btn-theme-edit" title="แก้ไข">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Medicine_id" class="btn btn-sm btn-theme-del" title="ลบข้อมูล">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
                var name = row.getAttribute('data-name') || '';
                var code = row.getAttribute('data-code') || '';
                var matchesSearch = !search || name.indexOf(search) !== -1 || code.indexOf(search) !== -1;

                if (matchesFilter && matchesSearch) {
                    row.classList.remove('row-hidden');
                    visibleCount++;
                } else {
                    row.classList.add('row-hidden');
                }
            });

            var noResults = document.getElementById('noResults');
            var hasAnyRow = rows.length > 0;
            noResults.style.display = (hasAnyRow && visibleCount === 0) ? 'block' : 'none';
        }

        // Filter pills
        document.querySelectorAll('.filter-pill').forEach(function (btn) {
            btn.addEventListener('click', function () {
                currentFilter = btn.getAttribute('data-filter');
                document.querySelectorAll('.filter-pill').forEach(function (b) { b.classList.remove('active'); });
                document.querySelectorAll('.stat-card[data-filter]').forEach(function (c) { c.classList.remove('active'); });
                btn.classList.add('active');
                var card = document.querySelector('.stat-card[data-filter="' + currentFilter + '"]');
                if (card) card.classList.add('active');
                applyFilters();
            });
        });

        // Stat cards act as filter shortcuts too
        document.querySelectorAll('.stat-card[data-filter]').forEach(function (card) {
            card.addEventListener('click', function () {
                var f = card.getAttribute('data-filter');
                var pill = document.querySelector('.filter-pill[data-filter="' + f + '"]');
                if (pill) pill.click();
            });
        });

        document.getElementById('searchInput').addEventListener('input', applyFilters);

        // Selection handling
        var selectAll = document.getElementById('selectAll');
        var checkboxes = document.querySelectorAll('.row-check');

        function updateSelectionBar() {
            var selected = document.querySelectorAll('.row-check:checked');
            var bar = document.getElementById('selectionBar');
            var totalCost = 0;
            selected.forEach(function (cb) { totalCost += parseFloat(cb.getAttribute('data-cost')) || 0; });

            if (selected.length > 0) {
                bar.style.display = 'flex';
                document.getElementById('selCount').textContent = selected.length;
                document.getElementById('selCost').textContent = totalCost.toLocaleString('en-US', { maximumFractionDigits: 0 });
            } else {
                bar.style.display = 'none';
            }
        }

        checkboxes.forEach(function (cb) {
            cb.addEventListener('change', updateSelectionBar);
        });

        if (selectAll) {
            selectAll.addEventListener('change', function () {
                document.querySelectorAll('#lowStockTable tbody tr:not(.row-hidden) .row-check').forEach(function (cb) {
                    cb.checked = selectAll.checked;
                });
                updateSelectionBar();
            });
        }

        window.clearSelection = function () {
            checkboxes.forEach(function (cb) { cb.checked = false; });
            if (selectAll) selectAll.checked = false;
            updateSelectionBar();
        };

        window.printSelection = function () {
            var selected = document.querySelectorAll('.row-check:checked');
            if (selected.length === 0) { return; }

            var tbody = document.querySelector('#printTable tbody');
            tbody.innerHTML = '';
            var i = 1;
            selected.forEach(function (cb) {
                var tr = document.createElement('tr');
                tr.innerHTML =
                   
                    '<td>' + cb.getAttribute('data-code') + '</td>' +
                    '<td>' + cb.getAttribute('data-name') + '</td>' +
                    '<td>' + cb.getAttribute('data-roq') + ' ' + cb.getAttribute('data-unit') + '</td>' +
                    '<td>' + (parseFloat(cb.getAttribute('data-cost')) || 0).toLocaleString('en-US', { maximumFractionDigits: 0 }) + '</td>';
                tbody.appendChild(tr);
            });

            window.print();
        };

        window.exportCsv = function () {
            var selected = document.querySelectorAll('.row-check:checked');
            var source = selected.length > 0
                ? selected
                : document.querySelectorAll('#lowStockTable tbody tr:not(.row-hidden) .row-check');

            if (source.length === 0) { return; }

            var rows = [[, 'ชื่อเวชภัณฑ์/ยา', 'จำนวนสั่งซื้อ', 'หน่วย', 'มูลค่าประมาณ (บาท)']];
            source.forEach(function (cb) {
                rows.push([
                    
                    cb.getAttribute('data-name'),
                    cb.getAttribute('data-roq'),
                    cb.getAttribute('data-unit'),
                    cb.getAttribute('data-cost')
                ]);
            });

            var csvContent = rows.map(function (r) {
                return r.map(function (v) { return '"' + String(v).replace(/"/g, '""') + '"'; }).join(',');
            }).join('\r\n');

            var blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'purchase-order-list-' + new Date().toISOString().slice(0, 10) + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };

        applyFilters();
        })();-->
</script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEl = document.getElementById('ropModal');
            if (!modalEl) return;
            var modal = new bootstrap.Modal(modalEl);
            var token = document.querySelector('#ropTokenForm input[name="__RequestVerificationToken"]').value;
            var urlSingle = '@Url.Action("SetReorderPoint", "Medicines")';
            var urlBulk = '@Url.Action("BulkSetReorderPoint", "Medicines")';
            var targetIds = [];
            var bulkMode = false;

            var input = document.getElementById('ropInput');
            var errBox = document.getElementById('ropError');

            function showError(msg) { errBox.textContent = msg; errBox.style.display = msg ? 'block' : 'none'; }

            function selectedIds() {
                return Array.prototype.map.call(document.querySelectorAll('.rop-check:checked'), function (c) { return c.value; });
            }

            function updateBulkBar() {
                var n = selectedIds().length;
                document.getElementById('ropSelCount').textContent = n;
                document.getElementById('ropBulkBar').style.display = n > 0 ? 'flex' : 'none';
            }

            document.querySelectorAll('.rop-check').forEach(function (c) { c.addEventListener('change', updateBulkBar); });

            var selectAll = document.getElementById('ropSelectAll');
            if (selectAll) selectAll.addEventListener('change', function () {
                document.querySelectorAll('.rop-check').forEach(function (c) { c.checked = selectAll.checked; });
                updateBulkBar();
            });

            document.getElementById('btnClearSel').addEventListener('click', function () {
                document.querySelectorAll('.rop-check').forEach(function (c) { c.checked = false; });
                if (selectAll) selectAll.checked = false;
                updateBulkBar();
            });

            // ทีละรายการ
            document.querySelectorAll('.btn-edit-rop').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    bulkMode = false;
                    targetIds = [btn.getAttribute('data-id')];
                    document.getElementById('ropTarget').textContent = btn.getAttribute('data-name') + ' (' + btn.getAttribute('data-id') + ')';
                    document.getElementById('ropAutoInfo').textContent = 'ค่าอัตโนมัติปัจจุบัน: ' + btn.getAttribute('data-auto') + ' ' + btn.getAttribute('data-unit');
                    document.getElementById('ropUnit').textContent = '(' + btn.getAttribute('data-unit') + ')';
                    input.value = btn.getAttribute('data-manual') || '';
                    showError('');
                    modal.show();
                    setTimeout(function () { input.focus(); input.select(); }, 300);
                });
            });

            // พร้อมกันหลายรายการ
            document.getElementById('btnBulkRop').addEventListener('click', function () {
                targetIds = selectedIds();
                if (targetIds.length === 0) return;
                bulkMode = true;
                document.getElementById('ropTarget').textContent = 'กำหนดค่าเดียวกันให้ ' + targetIds.length + ' รายการที่เลือก';
                document.getElementById('ropAutoInfo').textContent = 'ค่านี้จะเขียนทับค่าที่กำหนดเองของแต่ละรายการ';
                document.getElementById('ropUnit').textContent = '';
                input.value = '';
                showError('');
                modal.show();
                setTimeout(function () { input.focus(); }, 300);
            });

            function submit(valueOrNull) {
                var body = new URLSearchParams();
                body.append('__RequestVerificationToken', token);
                if (valueOrNull !== null) body.append('value', valueOrNull);
                if (bulkMode) { targetIds.forEach(function (id) { body.append('ids', id); }); }
                else { body.append('id', targetIds[0]); }

                fetch(bulkMode ? urlBulk : urlSingle, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: body.toString()
                })
                .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                .then(function (res) {
                    if (res.success) { modal.hide(); window.location.reload(); }
                    else { showError(res.message || 'บันทึกไม่สำเร็จ'); }
                })
                .catch(function () { showError('เกิดข้อผิดพลาดในการเชื่อมต่อ กรุณาลองใหม่อีกครั้ง'); });
            }

            document.getElementById('btnRopSave').addEventListener('click', function () {
                var v = (input.value || '').trim();
                if (v === '') { submit(null); return; }
                if (!/^\d+$/.test(v)) { showError('กรุณากรอกจำนวนเต็มตั้งแต่ 0 ขึ้นไป'); return; }
                submit(v);
            });

            document.getElementById('btnRopClear').addEventListener('click', function () { submit(null); });

            input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); document.getElementById('btnRopSave').click(); } });
        });
    </script>

@model IEnumerable<DrugInventoryPro.Models.Receive>

@{
    ViewData["Title"] = "ประวัติการรับยาเข้าคลัง";
}

<style>
    /* 🌟 Ergonomic Medical UI/UX Theme (Pharmacist Strain Prevention) */
    :root {
        --med-primary: #026AA7;
        --med-primary-hover: #025383;
        --med-bg: #F8FAFC;
        --med-card-bg: #FFFFFF;
        --med-text-main: #1E293B;
        --med-text-muted: #64748B;
        --med-border: #E2E8F0;
        --med-success: #059669;
        --med-success-bg: #ECFDF5;
        --med-header-bg: #F0F9FF;
    }

    body {
        background-color: var(--med-bg);
        font-family: 'Sarabun', sans-serif;
        color: var(--med-text-main);
    }

    /* Page Heading */
    .page-title {
        color: var(--med-text-main);
        font-weight: 700;
        font-size: 1.4rem;
    }

    .page-subtitle {
        color: var(--med-text-muted);
        font-size: 0.875rem;
    }

    /* Buttons */
    .btn-med-primary {
        background-color: var(--med-primary);
        color: #FFFFFF;
        border: none;
        border-radius: 8px;
        padding: 9px 20px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 2px 6px rgba(2, 106, 167, 0.18);
    }

        .btn-med-primary:hover {
            background-color: var(--med-primary-hover);
            color: #FFFFFF;
            box-shadow: 0 4px 12px rgba(2, 106, 167, 0.28);
        }

    .btn-med-secondary {
        background-color: #FFFFFF;
        color: var(--med-text-main);
        border: 1px solid var(--med-border);
        border-radius: 8px;
        padding: 9px 18px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s ease-in-out;
    }

        .btn-med-secondary:hover {
            background-color: #F1F5F9;
            color: var(--med-primary);
            border-color: #CBD5E1;
        }

    .btn-med-outline-sm {
        background-color: #FFFFFF;
        color: var(--med-primary);
        border: 1px solid var(--med-primary);
        border-radius: 6px;
        padding: 5px 14px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s ease-in-out;
    }

        .btn-med-outline-sm:hover {
            background-color: var(--med-primary);
            color: #FFFFFF;
        }

    /* Cards & Tables */
    .card-med-table {
        border: 1px solid var(--med-border);
        border-radius: 12px;
        background: var(--med-card-bg);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }

    .table-med {
        margin-bottom: 0;
    }

        .table-med thead {
            background-color: var(--med-header-bg);
            border-bottom: 1px solid var(--med-border);
        }

            .table-med thead th {
                color: #0369A1;
                font-weight: 700;
                font-size: 0.875rem;
                padding: 14px 16px;
                border-bottom: none;
            }

        .table-med tbody td {
            padding: 14px 16px;
            color: var(--med-text-main);
            border-bottom: 1px solid #F1F5F9;
            font-size: 0.9rem;
        }

        .table-med tbody tr:hover {
            background-color: #F8FAFC;
        }

    /* Status Badges */
    .badge-status-completed {
        background-color: var(--med-success-bg);
        color: var(--med-success);
        border: 1px solid #A7F3D0;
        padding: 5px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    /* Alert Styling */
    .alert-med-success {
        background-color: var(--med-success-bg);
        border: 1px solid #A7F3D0;
        color: #065F46;
        border-radius: 10px;
        font-weight: 500;
        padding: 12px 18px;
    }

    /* Modal Styling */
    .med-modal .modal-content {
        border: 1px solid var(--med-border);
        border-radius: 14px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .med-modal .modal-header {
        background-color: var(--med-header-bg);
        border-bottom: 1px solid var(--med-border);
        padding: 16px 24px;
    }

    .med-modal .modal-title {
        color: var(--med-primary);
        font-weight: 700;
        font-size: 1.1rem;
    }

    .med-modal .modal-body {
        padding: 24px;
        background-color: #FFFFFF;
    }

    .med-modal .modal-footer {
        background-color: #F8FAFC;
        border-top: 1px solid var(--med-border);
        padding: 12px 24px;
    }

    .med-modal .form-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--med-text-main);
        margin-bottom: 6px;
    }

    .med-modal .form-control,
    .med-modal .form-select {
        border: 1px solid #CBD5E1;
        border-radius: 8px;
        padding: 9px 12px;
        font-size: 0.9rem;
        color: var(--med-text-main);
        transition: all 0.2s ease-in-out;
    }

        .med-modal .form-control:focus,
        .med-modal .form-select:focus {
            border-color: var(--med-primary);
            box-shadow: 0 0 0 3px rgba(2, 106, 167, 0.15);
            outline: none;
        }

    .med-modal input[type="file"]::file-selector-button {
        background-color: #E0F2FE;
        color: #0369A1;
        border: none;
        border-radius: 6px;
        padding: 4px 12px;
        margin-right: 10px;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s ease;
    }

        .med-modal input[type="file"]::file-selector-button:hover {
            background-color: #BAE6FD;
            color: #0284C7;
        }
</style>

<div class="container py-4">

    <!-- Success & Error Alerts -->
    @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-med-success alert-dismissible fade show mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@(TempData["Success"] ?? TempData["SuccessMessage"])</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary"></i>
                <span>ทะเบียนประวัติการรับยาเข้าคลัง</span>
            </h2>
            <p class="page-subtitle mb-0">
                รายการรับยาทั้งหมดผ่านการคีย์ข้อมูลตามใบสั่งซื้อ (PO) และระบบอัปโหลดไฟล์
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-med-secondary d-flex align-items-center gap-2" type="button" data-bs-toggle="modal" data-bs-target="#excelModal">
                <i class="bi bi-file-earmark-excel-fill text-success"></i>
                <span>นำเข้าไฟล์</span>
            </button>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card card-med-table border-0 mb-5">
        <div class="table-responsive">
            <table class="table table-med align-middle">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 21%;">เลขที่เอกสาร</th>
                        <th style="width: 14%;">วันที่นำเข้า</th>
                        <th style="width: 15%;">เลขที่ Invoice</th>
                        <th style="text-center: 22%;">ผู้รับผิดชอบ</th>
                        <th class="text-center" style="width: 12%;">สถานะ</th>
                        <th class="text-center pe-4" style="width: 21%;">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.Receive_id</td>
                                <td>
                                    <i class="bi bi-calendar3 text-muted me-1"></i>
                                    @(item.Receive_date.HasValue? item.Receive_date.Value.ToString("dd/MM/yyyy") : "-")
                                </td>
                                <td><span class="text-secondary font-monospace">@(item.Invoice_number ?? "-")</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-1 text-secondary">
                                        <i class="bi bi-person-circle text-muted"></i>
                                        <span>
                                            @if (!string.IsNullOrEmpty(item.Received_by) && ViewBag.UserList != null)
                                            {
                                                var employee = ((IEnumerable<DrugInventoryPro.Models.User>)ViewBag.UserList).FirstOrDefault(u => u.User_id == item.Received_by);
                                                @(employee != null ? $"{employee.Firstname} {employee.Lastname}" : item.Received_by)
                                            }
                                            else
                                            {
                                                @:"ไม่ระบุเจ้าหน้าที่"
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge-status-completed">
                                        <i class="bi bi-check2-circle"></i>
                                        <span>@(item.Status ?? "Completed")</span>
                                    </span>
                                </td>
                              
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Receive_id" class="btn btn-med-outline-sm">
                                        <i class="bi bi-eye me-1"></i> ดูรายละเอียด
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox text-secondary d-block mb-2" style="font-size: 2.2rem; opacity: 0.6;"></i>
                                <span>ยังไม่มีประวัติการนำเข้าข้อมูลยาในระบบ</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal สำหรับนำเข้า CSV -->
<div class="modal fade med-modal" id="excelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-filetype-csv fs-4 text-primary"></i>
                    <h5 class="modal-title mb-0">นำเข้าข้อมูลจากไฟล์ CSV ใบเบิก</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Preview" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">ประเภทการรับเข้า <span class="text-danger">*</span></label>
                        <select name="importType" class="form-select" required>
                            <option value="">-- กรุณาเลือกประเภทยา/เวชภัณฑ์ --</option>
                            <option value="MED">รับยาเข้าคลัง (MED)</option>
                            <option value="SUP">รับเวชภัณฑ์เข้าคลัง (SUP)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">เลขที่ใบส่งสินค้า / Invoice No. <span class="text-danger">*</span></label>
                        <input type="text" name="invoiceNo" class="form-control" placeholder="ระบุเลขที่บิล/ใบส่งของ" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">ผู้รับผิดชอบ / ผู้รับมอบ <span class="text-danger">*</span></label>
                        <input type="text" name="receivedBy" class="form-control" placeholder="ระบุรหัสหรือชื่อพนักงาน" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">เลือกไฟล์ใบเบิก (.csv) <span class="text-danger">*</span></label>
                        <input type="file" name="excelFile" class="form-control" accept=".csv" required />
                    </div>

                    <div class="mt-3 p-2 px-3 rounded-2" style="background-color: #F8FAFC; border: 1px dashed #CBD5E1; font-size: 0.8rem; color: #64748B;">
                        <i class="bi bi-shield-check text-primary me-1"></i>
                        <span>รองรับเฉพาะไฟล์ <strong>.csv</strong> ใบเบิกตามมาตรฐาน 5 ประเภทหลักเท่านั้น ระบบจะตรวจสอบหัวเอกสารอัตโนมัติก่อนนำเข้า</span>
                    </div>

                </div>
                <div class="modal-footer d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-med-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-med-primary d-flex align-items-center gap-2">
                        <i class="bi bi-search"></i>
                        <span>ตรวจสอบข้อมูลก่อนบันทึก</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@model List<DrugInventoryPro.Models.ReceiveDetail>

@{
    ViewData["Title"] = "ตรวจสอบและนำเข้าข้อมูลรับยาเข้าคลัง";
    var invoiceNo = ViewBag.InvoiceNo as string ?? "-";
    var receivedBy = ViewBag.ReceivedBy as string ?? "-";
    var importType = ViewBag.ImportType as string ?? "MED";
    var rawDocumentTitle = ViewBag.DocumentTitle as string ?? "";
    var documentTitle = rawDocumentTitle?.TrimEnd(',', ' ');
    var duplicateCount = Model.Count(m => m.IsDuplicateOrSimilar);
}

<div class="container-fluid py-4">
    <div class="preview-card mb-4">
        <div class="preview-header-banner d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="fw-bold mb-1"><i class="bi bi-file-earmark-medical-fill me-2 text-info"></i>ตรวจสอบข้อมูลนำเข้า (@importType)</h4>
                <p class="mb-0 text-light opacity-75 small">
                    เอกสาร: <strong>@documentTitle</strong> | ใบส่งของ: <strong>@invoiceNo</strong> | ผู้รับ: <strong>@receivedBy</strong>
                </p>
            </div>
            <span class="badge bg-info text-dark font-monospace fs-6 px-3 py-2">
                ประเภท: @importType
            </span>
        </div>

        <div class="card-body p-4">
            <!-- ปุ่มจัดการเลือกหลายรายการ -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="fw-bold text-secondary">รายการทั้งหมด: <span id="kpiTotalItems">@Model.Count</span> รายการ</div>
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="deleteSelectedRows()">
                    <i class="bi bi-trash-fill me-1"></i> ลบรายการที่เลือก (<span id="selectedCount">0</span>)
                </button>
            </div>

            <form asp-action="ConfirmReceive" method="post" id="receiveConfirmForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="invoiceNo" value="@invoiceNo" />
                <input type="hidden" name="receivedBy" value="@receivedBy" />
                <input type="hidden" name="importType" value="@importType" />
                <input type="hidden" name="tempFilePath" value="@ViewBag.TempFilePath" />

                <div class="table-responsive rounded-3 border">
                    <table class="table table-hover align-middle table-preview" id="previewTable">
                        <thead>
                            <tr>
                                <th style="width: 3%;" class="text-center">
                                    <input type="checkbox" id="selectAll" class="form-check-input" onchange="toggleSelectAll(this)" />
                                </th>
                                <th style="width: 3%;" class="text-center">#</th>
                                <th style="width: 22%;">รายการ / บรรจุภัณฑ์</th>
                                <th style="width: 8%;" class="text-center">ประเภท/บัญชี</th>
                                <th style="width: 9%;" class="text-end">จำนวนรับ</th>
                                <th style="width: 10%;" class="text-end">ราคา/หน่วย</th>
                                <th style="width: 11%;" class="text-end">ราคารวม</th>
                                <th style="width: 10%;">LOT NUMBER</th>
                                <th style="width: 11%;">วันหมดอายุ</th>
                                <th style="width: 10%;">หมายเหตุ</th>
                                <th style="width: 3%;" class="text-center">ลบ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var item = Model[i];
                                var rowTotal = item.Quantity_received * (item.Price ?? 0);
                                <tr>
                                    <!-- Checkbox เลือกรายการ -->
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input row-checkbox" onchange="updateSelectedCount()" />
                                    </td>

                                    <input type="hidden" name="items.Index" value="@i" class="item-index" />
                                    <input type="hidden" name="items[@i].MatchedMedicineId" value="@item.MatchedMedicineId" />
                                    <input type="hidden" name="items[@i].MatchedMedicineName" value="@item.MatchedMedicineName" />
                                    <input type="hidden" name="items[@i].IsDuplicateOrSimilar" value="@item.IsDuplicateOrSimilar.ToString().ToLower()" />
                                    <input type="hidden" name="items[@i].SheetName" value="@item.SheetName" />
                                    <input type="hidden" name="items[@i].Unit_id" value="@item.Unit_id" />
                                    <input type="hidden" name="items[@i].Remark" value="@item.Remark" />

                                    <td class="row-number">@(i + 1)</td>

                                    <td>
                                        <input type="text" name="items[@i].Medicine_name" value="@item.Medicine_name" class="form-control form-control-sm fw-bold text-dark mb-1" required />
                                        <input type="text" name="items[@i].Packing_Size" value="@item.Packing_Size" class="form-control form-control-sm text-muted" placeholder="ขนาดบรรจุ" />
                                    </td>

                                    <td class="text-center">
                                        <input type="text" name="items[@i].Account_Type" value="@item.Account_Type" class="form-control form-control-sm text-center font-monospace fw-bold" />
                                    </td>

                                    <td>
                                        <input type="number" name="items[@i].Quantity_received" value="@item.Quantity_received" class="form-control form-control-sm text-end fw-bold text-primary qty-input" min="0" onchange="recalculateRow(this)" />
                                    </td>

                                    <td>
                                        <input type="number" step="0.01" name="items[@i].Price" value="@(item.Price?.ToString("F2") ?? "0.00")" class="form-control form-control-sm text-end price-input" onchange="recalculateRow(this)" />
                                    </td>

                                    <td class="text-end fw-bold text-dark row-total-val">
                                        @rowTotal.ToString("N2")
                                    </td>

                                    <td>
                                        <input type="text" name="items[@i].Lot_number" value="@(string.IsNullOrEmpty(item.Lot_number) ? "-" : item.Lot_number)" class="form-control form-control-sm font-monospace" />
                                    </td>

                                    <td>
                                        <input type="date" name="items[@i].Expiry_date" value="@item.Expiry_date.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                                    </td>

                                    <td>
                                        <small class="text-muted">@(string.IsNullOrEmpty(item.Remark) ? "-" : item.Remark)</small>
                                    </td>

                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removeRow(this)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">ย้อนกลับ</a>
                    <button type="submit" class="btn btn-success px-5 py-2 rounded-pill fw-bold">ยืนยันการบันทึกข้อมูล</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleSelectAll(master) {
        const checkboxes = document.querySelectorAll('.row-checkbox');
        checkboxes.forEach(cb => cb.checked = master.checked);
        updateSelectedCount();
    }

    function updateSelectedCount() {
        const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
        document.getElementById('selectedCount').textContent = checkedCount;
    }

    function deleteSelectedRows() {
        const selectedCheckboxes = document.querySelectorAll('.row-checkbox:checked');
        if (selectedCheckboxes.length === 0) {
            alert("กรุณาเลือกรายการที่ต้องการลบอย่างน้อย 1 รายการ");
            return;
        }

        if (confirm(`คุณต้องการลบรายการที่เลือกจำนวน ${selectedCheckboxes.length} รายการใช่หรือไม่?`)) {
            selectedCheckboxes.forEach(cb => {
                cb.closest('tr').remove();
            });
            document.getElementById('selectAll').checked = false;
            reindexRows();
            updateSelectedCount();
        }
    }

    function removeRow(btn) {
        if (confirm("คุณต้องการลบรายการนี้ใช่หรือไม่?")) {
            btn.closest("tr").remove();
            reindexRows();
            updateSelectedCount();
        }
    }

    function reindexRows() {
        const rows = document.querySelectorAll("#previewTable tbody tr");
        document.getElementById("kpiTotalItems").textContent = rows.length;

        rows.forEach((row, index) => {
            row.querySelector(".row-number").textContent = index + 1;

            // Re-index form input names
            const inputs = row.querySelectorAll("input, select");
            inputs.forEach(input => {
                if (input.name) {
                    input.name = input.name.replace(/items\[\d+\]/, `items[${index}]`);
                }
            });

            const hiddenIndex = row.querySelector(".item-index");
            if (hiddenIndex) hiddenIndex.value = index;
        });
    }

    function recalculateRow(element) {
        const row = element.closest("tr");
        const qty = parseFloat(row.querySelector(".qty-input").value) || 0;
        const price = parseFloat(row.querySelector(".price-input").value) || 0;
        const rowTotal = qty * price;

        row.querySelector(".row-total-val").textContent = rowTotal.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
</script>
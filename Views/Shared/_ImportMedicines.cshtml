@* ไฟล์: Views/Receive/_ImportMedicines.cshtml *@

<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Receive" asp-action="Preview" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="importExcelModalLabel">นำเข้าข้อมูลยาด้วยไฟล์ Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">ประเภทการรับเข้า</label>
                        <select name="importType" class="form-select" required>
                            <option value="MED">รับยาเข้าคลัง (MED)</option>
                            <option value="SUP">รับเวชภัณฑ์/อื่นๆ (SUP)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">เลขที่ใบส่งของ / Invoice No.</label>
                        <input type="text" name="invoiceNo" class="form-control" placeholder="ระบุเลขที่บิล/ใบส่งของ" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ผู้บันทึก / ผู้รับมอบ</label>
                        <input type="text" name="receivedBy" class="form-control" placeholder="ระบุชื่อผู้รับเข้า" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">เลือกไฟล์ Excel (.xlsx)</label>
                        <input type="file" name="excelFile" class="form-control" accept=".xlsx" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary">ตรวจสอบไฟล์</button>
                </div>
            </form>
        </div>
    </div>
</div>
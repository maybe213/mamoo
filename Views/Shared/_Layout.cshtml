@using Microsoft.AspNetCore.Http
@{
    var role = Context.Session.GetString("Role");
    var fullName = Context.Session.GetString("FullName") ?? "ผู้ใช้งานระบบ";
    var thCulture = new System.Globalization.CultureInfo("th-TH");
    var currentMonthName = DateTime.Now.ToString("MMMM yyyy", thCulture);
    var startSixMonthsAgo = DateTime.Now.AddMonths(-5).ToString("MMMM", thCulture);
    var endSixMonthsAgo = DateTime.Now.ToString("MMMM yyyy", thCulture);
    var sixMonthRange = $"{startSixMonthsAgo} ถึง {endSixMonthsAgo}";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SDHPH ระบบคลังยา</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            /* 1. สีพื้นหลังและข้อความ (Eye Strain Prevention) */
            --bg-main: #F4F5F7; /* เทาอ่อน สำหรับพื้นหลังหลัก ลดแสงจ้า */
            --bg-surface: #F8F9FA; /* ขาวหม่น (Off-white) สำหรับกล่องข้อมูล/Sidebar */
            --text-main: #333333; /* เทาเข้ม (Charcoal) ลด Contrast 100% ให้อ่านสบายตา */
            --text-muted: #6B7280; /* เทากลาง สำหรับข้อความรอง/ไอคอนเมนู */
            --border-color: #E5E7EB; /* สีเส้นขอบอ่อนๆ ไม่แย่งสายตา */
            /* 2. สี Action & Medical Status */
            --primary-blue: #2563EB; /* น้ำเงินหลัก (สงบ น่าเชื่อถือ) */
            --primary-blue-hover: #1D4ED8;
            --primary-blue-light: #EFF6FF; /* ฟ้าพาสเทล สำหรับพื้นหลัง Active (Gestalt Grouping) */

            --alert-red: #DC2626; /* แดง (วิกฤต/หยุด) */
            --alert-red-light: #FEF2F2;
            --warn-orange: #D97706; /* ส้ม (เตือน/ตรวจสอบ) */
            --success-green: #059669; /* เขียว (ปลอดภัย/ผ่าน) */
            /* 3. ความกว้าง Sidebar (ใช้ควบคุมการพับ/กาง) */
            --sidebar-width: 320px;
            --sidebar-collapsed-width: 84px;
        }

        body {
            background-color: var(--bg-main);
            font-family: 'Sarabun', sans-serif;
            color: var(--text-main);
            overflow-x: hidden;
        }

        /* ===== SIDEBAR (โครงสร้างหลัก) ===== */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--bg-surface);
            position: fixed;
            border-right: 1px solid var(--border-color);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.02); /* เงาฟุ้งบางๆ */
            transition: width 0.25s ease-in-out;
            overflow: visible;
        }

        .sidebar-header-section {
            flex-shrink: 0;
            padding-top: 15px;
            position: relative;
        }

        .sidebar-header {
            padding: 20px;
            text-align: center;
        }

        .sidebar-logo-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            background: var(--primary-blue-light);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px;
            color: var(--primary-blue);
            flex-shrink: 0;
            transition: width 0.25s, height 0.25s;
        }

            .sidebar-logo-icon i {
                font-size: 30px;
            }

        .sidebar-header h4 {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
            white-space: nowrap;
        }

        .sidebar-header small {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 500;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .role-section {
            padding: 0 20px 20px;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
            background: var(--bg-main);
            color: var(--text-muted);
            padding: 4px 16px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            font-size: 13px;
            white-space: nowrap;
        }

        /* ===== ปุ่มพับ/กาง Sidebar ===== */
        .sidebar-toggle-btn {
            position: absolute;
            top: 22px;
            right: -14px;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #fff;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 1010;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
            transition: transform 0.25s ease-in-out, color 0.2s, border-color 0.2s;
        }

            .sidebar-toggle-btn:hover {
                color: var(--primary-blue);
                border-color: var(--primary-blue-light);
            }

            .sidebar-toggle-btn i {
                font-size: 14px;
                transition: transform 0.25s ease-in-out;
            }

        .sidebar.collapsed .sidebar-toggle-btn i {
            transform: rotate(180deg);
        }

        /* ===== SIDEBAR MENU ===== */
        .sidebar-menu-scroll {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-bottom: 20px;
        }

            .sidebar-menu-scroll::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar-menu-scroll::-webkit-scrollbar-thumb {
                background-color: #D1D5DB;
                border-radius: 10px;
            }

        .nav-label {
            font-size: 13px;
            font-weight: 700;
            color: #9CA3AF; /* สีอ่อนลงเพื่อไม่ให้กวนสายตา */
            text-transform: uppercase;
            padding: 15px 24px 5px;
            letter-spacing: 0.5px;
            margin: 10px 10px 0 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
            overflow: hidden;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            margin: 4px 16px 4px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            color: var(--text-main);
            transition: all 0.2s ease-in-out;
            white-space: nowrap;
            overflow: hidden;
        }

            .sidebar a i {
                font-size: 18px;
                color: var(--text-muted);
                transition: color 0.2s;
                flex-shrink: 0;
            }

            .sidebar a:hover {
                background: var(--bg-main);
                color: var(--primary-blue);
            }

                .sidebar a:hover i {
                    color: var(--primary-blue);
                }

        /* เมนูที่ถูกเลือก (ลดภาระสมองด้วยพื้นหลังพาสเทล) */
        .sidebar .active-link {
            background: var(--primary-blue-light) !important;
            color: var(--primary-blue) !important;
            font-weight: 600;
        }

            .sidebar .active-link i {
                color: var(--primary-blue) !important;
            }

        /* ===== LOGOUT SECTION ===== */
        .logout-section {
            flex-shrink: 0;
            padding: 16px;
            border-top: 1px solid var(--border-color);
            background: var(--bg-surface);
        }

        .logout-link {
            display: flex !important;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: transparent !important;
            color: var(--text-muted) !important;
            font-weight: 500 !important;
            font-size: 14px !important;
            padding: 10px 16px !important;
            border-radius: 8px !important;
            border: 1px solid var(--border-color) !important;
            transition: all 0.2s ease-in-out !important;
            margin: 0 !important;
            white-space: nowrap;
            overflow: hidden;
        }

            /* แจ้งเตือนสีแดงเฉพาะเมื่อ Hover (ป้องกันจิ้มผิด) */
            .logout-link:hover {
                background: var(--alert-red-light) !important;
                color: var(--alert-red) !important;
                border-color: var(--alert-red-light) !important;
            }

        /* ===== CONTENT AREA ===== */
        .content {
            margin-left: var(--sidebar-width);
            width: calc(100vw - var(--sidebar-width));
            padding: 24px 32px;
            min-height: 100vh;
            transition: margin-left 0.25s ease-in-out, width 0.25s ease-in-out;
        }

        /* ===== STICKY HEADER ===== */
        .sticky-top-header {
            position: sticky;
            top: 15px;
            z-index: 1020;
            margin-bottom: 24px;
        }

        .custom-header-card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); /* เงาฟุ้งนุ่มๆ */
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .user-profile-badge {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-icon-bg {
            background-color: var(--bg-main);
            color: var(--text-muted);
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 1px solid var(--border-color);
        }

        /* ============================================================
                   ===== สถานะ "พับเก็บ" (COLLAPSED) ของ Sidebar =====
                   ============================================================ */
        .sidebar.collapsed {
            width: var(--sidebar-collapsed-width);
        }

            /* ซ่อนข้อความ/ป้าย ต่างๆ เมื่อพับ */
            .sidebar.collapsed .sidebar-header h4,
            .sidebar.collapsed .sidebar-header small,
            .sidebar.collapsed .role-section,
            .sidebar.collapsed .nav-label,
            .sidebar.collapsed .menu-text,
            .sidebar.collapsed .logout-link .menu-text {
                display: none;
            }

            .sidebar.collapsed .sidebar-logo-icon {
                width: 44px;
                height: 44px;
            }

                .sidebar.collapsed .sidebar-logo-icon i {
                    font-size: 22px;
                }

            /* จัดไอคอนเมนูให้อยู่กึ่งกลาง และเพิ่ม tooltip เมื่อ hover */
            .sidebar.collapsed a,
            .sidebar.collapsed .logout-link {
                justify-content: center;
                padding: 12px;
                margin: 4px 12px;
                position: relative;
            }

                .sidebar.collapsed a i,
                .sidebar.collapsed .logout-link i {
                    font-size: 20px;
                }

                /* Tooltip แบบง่าย: แสดงชื่อเมนูตอน hover ในโหมดพับ */
                .sidebar.collapsed a:hover::after,
                .sidebar.collapsed .logout-link:hover::after {
                    content: attr(data-title);
                    position: absolute;
                    left: calc(100% + 10px);
                    top: 50%;
                    transform: translateY(-50%);
                    background: #1F2937;
                    color: #fff;
                    padding: 6px 12px;
                    border-radius: 6px;
                    font-size: 13px;
                    white-space: nowrap;
                    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
                    z-index: 1050;
                    pointer-events: none;
                }

        .content.expanded {
            margin-left: var(--sidebar-collapsed-width);
            width: calc(100vw - var(--sidebar-collapsed-width));
        }

        /* ===== Responsive: มือถือ/แท็บเล็ต พับอัตโนมัติ ===== */
        @@media (max-width: 991.98px) {
            .sidebar {
                width: var(--sidebar-collapsed-width);
            }

                .sidebar .sidebar-header h4,
                .sidebar .sidebar-header small,
                .sidebar .role-section,
                .sidebar .nav-label,
                .sidebar .menu-text {
                    display: none;
                }

                .sidebar a, .sidebar .logout-link {
                    justify-content: center;
                }

            .content {
                margin-left: var(--sidebar-collapsed-width);
                width: calc(100vw - var(--sidebar-collapsed-width));
            }

            .sidebar.mobile-expanded {
                width: var(--sidebar-width);
            }

                .sidebar.mobile-expanded .sidebar-header h4,
                .sidebar.mobile-expanded .sidebar-header small,
                .sidebar.mobile-expanded .role-section,
                .sidebar.mobile-expanded .nav-label,
                .sidebar.mobile-expanded .menu-text {
                    display: block;
                }
        }
    </style>
</head>

<body>
    <div class="d-flex">
        <!-- ================= SIDEBAR ================= -->
        <div class="sidebar" id="mainSidebar">

            <div class="sidebar-header-section">

                <!-- ปุ่มพับ/กาง เมนู -->
                <div class="sidebar-toggle-btn" id="sidebarToggleBtn" onclick="toggleSidebar()" title="พับ/กางเมนู">
                    <i class="bi bi-chevron-left"></i>
                </div>

                <div class="sidebar-header">
                    <div class="sidebar-logo-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                    <h4>SDHPH</h4>
                    <small>DRUG INVENTORY PRO</small>
                </div>

                @if (!string.IsNullOrEmpty(role))
                {
                    <div class="role-section">
                        <span class="role-badge"><i class="bi bi-person-badge"></i> <span class="menu-text">@role</span></span>
                    </div>
                }
            </div>

            <div class="sidebar-menu-scroll">

                <p class="nav-label"><i class="bi bi-grid-fill"></i> <span class="menu-text">เมนูหลัก</span></p>
                <a asp-controller="Dashboard" asp-action="Index" data-title="หน้าแรก (Dashboard)" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active-link" : "")">
                    <i class="bi bi-speedometer2"></i> <span class="menu-text">หน้าแรก (Dashboard)</span>
                </a>

                @if (role == "Admin")
                {
                    <p class="nav-label"><i class="bi bi-gear-fill"></i> <span class="menu-text">จัดการระบบ</span></p>
                    <a asp-controller="Users" asp-action="Index" data-title="จัดการผู้ใช้" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active-link" : "")">
                        <i class="bi bi-people"></i> <span class="menu-text">จัดการผู้ใช้</span>
                    </a>
                    <a asp-controller="Departments" asp-action="Index" data-title="ข้อมูลแผนก" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Departments" ? "active-link" : "")">
                        <i class="bi bi-hospital"></i> <span class="menu-text">ข้อมูลแผนก</span>
                    </a>
                }

                @if (role == "Pharmacist")
                {
                    <p class="nav-label"><i class="bi bi-box-seam-fill"></i> <span class="menu-text">บริหารคลังยา</span></p>
                    <a asp-controller="Medicines" asp-action="Index" data-title="ทะเบียนยาและเวชภัณฑ์" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Medicines" ? "active-link" : "")">
                        <i class="bi bi-capsule"></i> <span class="menu-text">ทะเบียนยาและเวชภัณฑ์</span>
                    </a>
                    <a asp-controller="Receive" asp-action="Index" data-title="รับเข้าคลังยา" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Receive" ? "active-link" : "")">
                        <i class="bi bi-box-arrow-in-down"></i> <span class="menu-text">รับเข้าคลังยา</span>
                    </a>
                    <a asp-controller="StockAlert" asp-action="index" data-title="จัดการล็อตและวันหมดอายุ" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "PurchaseOrders" ? "active-link" : "")">
                        <i class="bi bi-cart-check"></i> <span class="menu-text">จัดการล็อตและวันหมดอายุ</span>
                    </a>

                    <p class="nav-label"><i class="bi bi-clipboard2-pulse-fill"></i> <span class="menu-text">การเบิกจ่าย</span></p>
                    <a asp-controller="Dispense" asp-action="Create" data-title="ขอเบิกยาและเวชภัณฑ์" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Create" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Dispense" ? "active-link" : "")">
                        <i class="bi bi-clipboard-plus"></i> <span class="menu-text">ขอเบิกยาและเวชภัณฑ์</span>
                    </a>
                    <a asp-controller="Dispense" asp-action="Index" data-title="สถานะคำขอเบิก" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Dispense" ? "active-link" : "")">
                        <i class="bi bi-list-check"></i> <span class="menu-text">สถานะคำขอเบิก</span>
                    </a>
                    <a asp-controller="Dispense" asp-action="Approve" data-title="อนุมัติการเบิกจ่าย" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Approve" ? "active-link" : "")">
                        <i class="bi bi-shield-check"></i> <span class="menu-text">อนุมัติการเบิกจ่าย</span>
                    </a>
                }

                @if (role == "Staff")
                {
                    <p class="nav-label"><i class="bi bi-clipboard2-pulse-fill"></i> <span class="menu-text">การเบิกจ่าย</span></p>
                    <a asp-controller="Dispense" asp-action="Create" data-title="สร้างคำขอเบิกยา" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Create" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Dispense" ? "active-link" : "")">
                        <i class="bi bi-clipboard-plus"></i> <span class="menu-text">สร้างคำขอเบิกยา</span>
                    </a>
                    <a asp-controller="Dispense" asp-action="Index" data-title="ตรวจสอบสถานะคำขอ" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Dispense" ? "active-link" : "")">
                        <i class="bi bi-list-check"></i> <span class="menu-text">ตรวจสอบสถานะคำขอ</span>
                    </a>
                }
            </div>

            <div class="logout-section">
                <a class="logout-link" asp-controller="Account" asp-action="Logout" data-title="ออกจากระบบ" onclick="return confirm('ยืนยันการออกจากระบบ?')">
                    <i class="bi bi-power"></i> <span class="menu-text">ออกจากระบบ</span>
                </a>
            </div>

        </div>

        <!-- ================= CONTENT AREA ================= -->
        <div class="content" id="mainContent">
            <div class="sticky-top-header">
                <div class="custom-header-card">

                    <div class="d-flex align-items-center gap-3">
                        <div style="background-color: var(--primary-blue-light); color: var(--primary-blue); padding: 8px 12px; border-radius: 8px;">
                            <i class="@(ViewData["HeaderIcon"] ?? "bi bi-speedometer2") fs-5"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold" style="font-size: 18px;">@(ViewData["HeaderTitle"] ?? "ระบบจัดการคลังยาและเวชภัณฑ์")</h5>
                            <span class="text-muted small fw-medium">รพ.สต.ท่าทองใหม่ | ข้อมูลสรุป ณ เดือน @currentMonthName</span>
                        </div>
                    </div>

                    <div class="user-profile-badge">
                        <div class="text-end" style="line-height: 1.2;">
                            <span class="fw-bold" style="font-size: 14px; color: var(--text-main);">@fullName</span><br />
                            <span style="font-size: 12px; color: var(--text-muted); font-weight: 500;">@(role ?? "Guest")</span>
                        </div>
                        <div class="user-icon-bg">
                            <i class="bi bi-person-fill fs-5"></i>
                        </div>
                    </div>

                </div>
            </div>

            @RenderBody()

        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ===== Sidebar Collapse / Expand =====
        (function () {
            var sidebar = document.getElementById('mainSidebar');
            var content = document.getElementById('mainContent');
            var STORAGE_KEY = 'sdhph_sidebar_collapsed';

            // โหลดสถานะที่บันทึกไว้ล่าสุด (จำค่าไว้ข้ามหน้า)
            if (window.innerWidth > 991.98 && localStorage.getItem(STORAGE_KEY) === '1') {
                sidebar.classList.add('collapsed');
                content.classList.add('expanded');
            }

            window.toggleSidebar = function () {
                // จอเล็ก (มือถือ/แท็บเล็ต): ใช้ mobile-expanded แทน เพราะ base state ถูกพับไว้แล้ว
                if (window.innerWidth <= 991.98) {
                    sidebar.classList.toggle('mobile-expanded');
                    return;
                }

                sidebar.classList.toggle('collapsed');
                content.classList.toggle('expanded');
                localStorage.setItem(STORAGE_KEY, sidebar.classList.contains('collapsed') ? '1' : '0');
            };
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
)